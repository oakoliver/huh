# Render from the repo root: vhs assets/tapes/burger.tape
Output assets/burger.gif

Set Shell bash
Set FontSize 16
Set Width 1000
Set Height 520
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type "export PS1='> ' && clear"
Enter
Show

Type "bun examples/burger.ts"
Sleep 300ms
Enter
Sleep 1.5s
Down@300ms 3
Sleep 500ms
Enter
Sleep 700ms
Type "x"
Down@250ms 2
Type "x"
Down@250ms 2
Type "x"
Sleep 700ms
Enter
Sleep 800ms
Type "Ada Lovelace"
Sleep 500ms
Enter
Sleep 500ms
Type "Extra pickles, no onions."
Sleep 600ms
Enter
Sleep 600ms
Left
Sleep 800ms
Enter
Sleep 2.5s
